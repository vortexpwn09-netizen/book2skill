# Core
BOOK2SKILL_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
BOOK2SKILL_DB_PATH=./data/book2skill.db
BOOK2SKILL_FREE_TRIAL_DAYS=7
BOOK2SKILL_IP_TRIAL_COOLDOWN_DAYS=365
BOOK2SKILL_IP_HASH_SECRET=
BOOK2SKILL_COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=127.0.0.1

# Stripe subscription billing. Create a recurring Price in Stripe and configure its ID.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_LABEL=Premium subscription

# Optional AI provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# Optional output settings
BOOK2SKILL_OUTPUT_DIR=./output
